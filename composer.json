{
    "name": "phpbb/oberon",
    "type": "phpbb-extension",
    "description": "An extension for the Customisation DB",
    "homepage": "https://www.phpbb.com",
    "version": "4.0.0-dev",
    "time": "2022-07-23",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "battye",
            "email": "battye@phpbb.com",
            "homepage": "https://forums.cricketmx.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "phpbb/phpbb": ">4.0.0@dev",
        "composer/installers": "~1.0.0"
    },
    "extra": {
        "display-name": "Customisation DB",
        "soft-require": {
            "phpbb/phpbb": ">4.0.0@dev"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/oberon",
            "filename": "version_check"
        }
    }
}
